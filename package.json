{
  "author": "",
  "description": "A TypeScript library of DOM node wrappers.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-promise": "^7.3.0",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "find-up": "^8.0.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "ISC",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,jsx}": [
      "prettier --write",
      "npm run lint -- --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "main": "./dist/index.js",
  "name": "@fibber/xdom",
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "npm run dist:clean && npm run build",
    "dist:clean": "rimraf dist",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --cache --format=stylish --cache-location .eslintcache --no-warn-ignored --max-warnings 0",
    "lint:self": "npm run lint -- ./eslint.config.mjs \"./eslint.config/**/*.mjs\"",
    "lint:self:fix": "npm run lint:self -- --fix",
    "lint:src": "npm run lint -- ./src",
    "lint:src:fix": "npm run lint:src -- --fix",
    "lint:src:fix:no-cache": "npm run lint:src:fix -- --no-cache",
    "lint:src:no-cache": "npm run lint:src -- --no-cache",
    "lint:test": "npm run lint -- ./test",
    "lint:test:fix": "npm run lint:test -- --fix",
    "prepare": "husky",
    "repo:meta:sync": "node repo/meta/sync.mjs",
    "stats:general": "tsx stats/general/script.ts",
    "stats:general:collect": "npm run stats:general -- --collect-only",
    "stats:general:render": "npm run stats:general -- --render-only",
    "stats:general:test": "node --import ./test/setup/register.mjs --test \"stats/general/script.test.ts\"",
    "test": "npm run test:unit && npm run test:unit:decorators",
    "test:unit": "node --import ./test/setup/register.mjs --test \"test/unit/**/*.test.ts\"",
    "test:unit:decorators": "cd test && tsx --test \"decorator/**/*.test.ts\"",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit -p test/tsconfig.json",
    "validate": "npm run validate:static && npm run test",
    "validate:fix": "npm run validate:static:fix && npm run test",
    "validate:lint": "npm run lint:src && npm run lint:test",
    "validate:lint:fix": "npm run lint:src:fix && npm run lint:test:fix",
    "validate:static": "npm run type-check && npm run type-check:test && npm run validate:lint && npm run format:check",
    "validate:static:fix": "npm run type-check && npm run type-check:test && npm run validate:lint:fix && npm run format:write"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
