#!/usr/bin/env sh

zero="0000000000000000000000000000000000000000"
delete_only=true

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" != "$zero" ]; then
    delete_only=false
  fi
done

if [ "$delete_only" = true ]; then
  echo "Skipping pre-push checks: push only deletes remote ref(s)."
  exit 0
fi

echo "🚀 Running pre-push/production checks..."
npm run validate || exit 1

# Sync package.json metadata (single source of truth) to the GitHub repo:
# description + homepage -> About, keywords -> Topics. Non-fatal: metadata
# sync must never block a push (offline, gh missing, repo not yet on GitHub).
npm run repo:meta:sync || echo "⚠️ repo metadata sync skipped"

# Collect a fresh src/ snapshot and re-render stats/general/latest.md + the
# graph (pops graph.html open in the browser). Non-fatal: a stats hiccup
# must never block a push.
npm run stats:general || echo "⚠️ stats collection/render skipped"
